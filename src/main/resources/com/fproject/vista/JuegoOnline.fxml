<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox id="MainBackground" alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" spacing="12.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fproject.controlador.ControladorJuegoOnline">
   <padding>
      <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
   </padding>
   <children>
      <Label fx:id="lblRonda" style="-fx-text-fill: white;" text="Label">
         <effect>
            <DropShadow />
         </effect>
         <font>
            <Font name="Arial Bold" size="25.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" prefHeight="135.0" prefWidth="1232.0" spacing="250.0" style="-fx-background-color: #392E2A; -fx-border-color: #FF692E; -fx-border-radius: 10px; -fx-background-radius: 15px; -fx-border-width: 5px;">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="400.0">
               <children>
                  <Label fx:id="lblRival" style="-fx-font-weight: bold; -fx-text-fill: #ffd56b;" text="Rival">
                     <font>
                        <Font name="Arial Bold" size="16.0" />
                     </font>
                  </Label>
                  <HBox fx:id="cartasRival" prefHeight="100.0" prefWidth="200.0" />
               </children>
            </VBox>
            <VBox alignment="TOP_CENTER" layoutX="429.0" layoutY="11.0" prefHeight="200.0" prefWidth="400.0">
               <children>
                  <Label fx:id="lblJugador" style="-fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Tú">
                     <font>
                        <Font name="Arial Bold" size="16.0" />
                     </font>
                  </Label>
                  <HBox fx:id="cartasYo" prefHeight="100.0" prefWidth="200.0" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
      <Label fx:id="lblEstado" style="-fx-text-fill: white;" text="Label">
         <effect>
            <DropShadow />
         </effect>
         <font>
            <Font name="Arial Bold" size="25.0" />
         </font>
      </Label>
      <HBox fx:id="manoJugador" alignment="CENTER" minHeight="105.0" spacing="10.0" />
      <HBox alignment="CENTER" spacing="40.0">
         <children>
            <VBox alignment="BOTTOM_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="340.0" prefWidth="440.0" spacing="8.0">
               <children>
                  <ImageView fx:id="imgRival" fitHeight="180.0" fitWidth="180.0" preserveRatio="true" scaleX="-1.0" styleClass="jugador">
                     <image>
                        <Image url="@images/Sumo1.png" />
                     </image>
                     <effect>
                        <DropShadow />
                     </effect>
                  </ImageView>
               </children>
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
            </VBox>
            <VBox fx:id="zonaRonda" alignment="CENTER" spacing="10.0" visible="false" managed="false"/>
            <VBox alignment="BOTTOM_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="340.0" prefWidth="440.0" spacing="8.0">
               <children>
                  <ImageView fx:id="imgYo" fitHeight="180.0" fitWidth="180.0" preserveRatio="true" styleClass="jugador">
                     <image>
                        <Image url="@images/Box1.png" />
                     </image>
                     <effect>
                        <DropShadow />
                     </effect>
                  </ImageView>
               </children>
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
      <Region prefHeight="4.0" />
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button fx:id="btnRevancha" disable="true" onAction="#pedirRevancha" style="-fx-text-fill: white;" styleClass="btnMain" text="Revancha" />
            <Button onAction="#volverLobby" style="-fx-text-fill: white;" styleClass="btnMain" text="Volver al lobby" />
         </children>
      </HBox>
   </children>
</VBox>
