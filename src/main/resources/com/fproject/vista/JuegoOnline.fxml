<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox id="MainBackground" alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" spacing="15.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fproject.controlador.ControladorJuegoOnline">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Pokémon Card-Jitsu en línea" />
      <HBox alignment="CENTER" spacing="30.0">
         <children>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <ImageView fitHeight="90.0" fitWidth="90.0" preserveRatio="true" styleClass="jugador">
                     <image>
                        <Image url="@images/Pinguino.png" />
                     </image>
                  </ImageView>
                  <Label fx:id="lblJugador" style="-fx-font-weight: bold;" text="Tú" />
                  <Label fx:id="lblCartasGanadas" maxWidth="450.0" text="Cartas ganadas: 0" wrapText="true" />
                  <HBox fx:id="manoJugador" alignment="CENTER" spacing="5.0" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <ImageView fitHeight="90.0" fitWidth="90.0" preserveRatio="true" styleClass="jugador">
                     <image>
                        <Image url="@images/PinguinoMalo.png" />
                     </image>
                  </ImageView>
                  <Label fx:id="lblRival" style="-fx-font-weight: bold;" text="Rival" />
                  <Label fx:id="lblCartasGanadasRival" maxWidth="450.0" text="Cartas ganadas: 0" wrapText="true" />
                  <Label text="Mano del rival oculta" />
               </children>
            </VBox>
         </children>
      </HBox>
      <Label fx:id="lblRonda" maxWidth="900.0" style="-fx-font-weight: bold;" text="" textAlignment="CENTER" wrapText="true" />
      <Label fx:id="lblEstado" maxWidth="900.0" text="Esperando al servidor..." textAlignment="CENTER" wrapText="true" />
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button fx:id="btnRevancha" disable="true" onAction="#pedirRevancha" styleClass="btnMain" text="Revancha" />
            <Button onAction="#volverLobby" styleClass="btnMain" text="Volver al lobby" />
         </children>
      </HBox>
   </children>
</VBox>
